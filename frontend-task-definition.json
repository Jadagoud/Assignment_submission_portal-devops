{
  "containerDefinitions": [
    {
      "name": "assignment-frontend",
      "image": "451782721795.dkr.ecr.eu-north-1.amazonaws.com/assignment-frontend:v2",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/assignment-frontend",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "assignment-frontend",
  "taskRoleArn": "arn:aws:iam::451782721795:role/assignmentECSTaskRole",
  "executionRoleArn": "arn:aws:iam::451782721795:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}